# OPTIONAL: production email/password authentication only.
# The demonstration works without these values.
# Configure these as server runtime variables, never NEXT_PUBLIC variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
PRODUCTION_ADMIN_EMAIL=YOUR_VERIFIED_ADMIN_EMAIL
# No service-role key is used by this application.
